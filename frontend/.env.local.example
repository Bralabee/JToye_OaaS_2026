# ===========================
# J'Toye OaaS - Frontend Environment Configuration
# ===========================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local in the same directory
#    Windows: copy .env.local.example .env.local
#    Linux/Mac: cp .env.local.example .env.local
#
# 2. Update values as needed for your environment
# 3. NEVER commit .env.local to version control
#
# ===========================

# Backend API URL
# Points to the core-java Spring Boot API
# Default for local development: http://localhost:9090
# For Docker: http://localhost:9090 (uses host networking)
NEXT_PUBLIC_API_URL=http://localhost:9090

# Keycloak Configuration
# Client ID registered in Keycloak for this application
KEYCLOAK_CLIENT_ID=core-api

# Client secret from Keycloak (realm: jtoye-dev, client: core-api)
# The SAME value renders the realm core-api client secret at import, so this must
# match KEYCLOAK_CLIENT_SECRET in the root .env. Generate with: openssl rand -hex 32
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# Keycloak issuer URL (realm URL)
# Must match the issuer claim in JWT tokens
# Format: http://<host>:<port>/realms/<realm-name>
KEYCLOAK_ISSUER=http://localhost:8085/realms/jtoye-dev

# Public Keycloak URL for client-side redirects
# Used for OAuth authorization flows
# Should be same as KEYCLOAK_ISSUER without the /realms path for base URL
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8085/realms/jtoye-dev

# NextAuth Configuration
# URL where this Next.js app is running
# Must match the redirect URLs configured in Keycloak
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret for session encryption
# Generate a secure random string:
#   Linux/Mac: openssl rand -hex 32
#   Windows (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# IMPORTANT: rotate per environment; never commit the real value.
NEXTAUTH_SECRET=CHANGE_ME

# ===========================
# Optional Configuration
# ===========================

# Node environment (development, production, test)
# NODE_ENV=development

# Enable Next.js telemetry (set to 1 to disable)
# NEXT_TELEMETRY_DISABLED=1

# Logging level (error, warn, info, debug)
# LOG_LEVEL=info

# ===========================
# Onboarding Blocker UX (ONBD-05 / ONBD-03)
# ===========================
# Config-injected support channel + review SLA — surfaced on the vendor
# onboarding page (rejection/suspension support link + honest "in review" copy).
# Non-secret, build-time values (GLOBAL_RULE_6: no hardcoded support mailto/URL or
# "N days" literal in the UI). NEXT_PUBLIC_SUPPORT_URL takes precedence over the
# email when both are set; leave one blank to use the other.
NEXT_PUBLIC_SUPPORT_EMAIL=support@jtoye.co.uk
NEXT_PUBLIC_SUPPORT_URL=https://help.jtoye.co.uk/onboarding
# Whole number of UK business days a manual review is expected to take.
NEXT_PUBLIC_ONBOARDING_REVIEW_SLA_DAYS=2

# ===========================
# Platform operator legal identity (UK trading disclosure)
# ===========================
# The PLATFORM OPERATOR's Companies House registration, shown on platform
# surfaces only (dashboard footer, sign-in, /legal) — NEVER on tenant
# storefronts (each vendor trades under its own entity). The defaults in
# frontend/lib/company.ts are the verified J'Toye Digital Ltd values
# (company no. 16471464); override these ONLY for a white-label deployment
# operating under a different entity. NEXT_PUBLIC_* are baked at BUILD time
# (set as compose / Dockerfile build args). Leave REGISTERED_OFFICE blank to
# omit the street address from the public disclosure.
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=J'Toye Digital Ltd
# NEXT_PUBLIC_COMPANY_NUMBER=16471464
# NEXT_PUBLIC_COMPANY_REGISTRATION=England & Wales
# NEXT_PUBLIC_COMPANY_REGISTERED_OFFICE=
