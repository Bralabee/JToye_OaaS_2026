@@ -0,0 +1,69 @@
+package uk.jtoye.core.spike;
+
+import com.fasterxml.jackson.databind.node.ObjectNode;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.ApplicationContext;
+import org.springframework.http.MediaType;
+import org.springframework.mock.http.client.MockClientHttpRequest;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.client.MockRestServiceServer;
+import org.springframework.web.client.RestClient;
+import org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerAdapter;
+
+import java.time.Instant;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.springframework.test.web.client.match.MockRestRequestMatchers.requestTo;
+import static org.springframework.test.web.client.response.MockRestResponseCreators.withSuccess;
+
+/** SPIKE ONLY (Boot 4.1.1 feasibility): prints which Jackson line is live. Never committed upstream. */
+abstract class BootSpikeJacksonProbeBase {
+    @Autowired ApplicationContext ctx;
+    @Autowired RequestMappingHandlerAdapter adapter;
+    @Autowired RestClient.Builder builder;
+
+    @Test
+    void probe() throws Exception {
+        StringBuilder sb = new StringBuilder("\nSPIKE-PROBE " + getClass().getSimpleName() + "\n");
+        for (String n : ctx.getBeanNamesForType(com.fasterxml.jackson.databind.ObjectMapper.class)) {
+            sb.append(" J2 ObjectMapper bean: ").append(n).append(" ").append(ctx.getBean(n).getClass().getName()).append("\n");
+        }
+        for (String n : ctx.getBeanNamesForType(tools.jackson.databind.ObjectMapper.class)) {
+            sb.append(" J3 ObjectMapper bean: ").append(n).append(" ").append(ctx.getBean(n).getClass().getName()).append("\n");
+        }
+        adapter.getMessageConverters().forEach(c -> sb.append(" MVC converter: ").append(c.getClass().getName()).append("\n"));
+
+        RestClient.Builder b = builder.clone();
+        MockRestServiceServer server = MockRestServiceServer.bindTo(b).build();
+        AtomicReference<String> body = new AtomicReference<>();
+        server.expect(requestTo("http://probe/x"))
+              .andExpect(req -> body.set(((MockClientHttpRequest) req).getBodyAsString()))
+              .andRespond(withSuccess());
+        ObjectNode node = new com.fasterxml.jackson.databind.ObjectMapper().createObjectNode();
+        node.put("enabled", false);
+        b.build().put().uri("http://probe/x").contentType(MediaType.APPLICATION_JSON).body(node).retrieve().toBodilessEntity();
+        sb.append(" RestClient wire body for Jackson2 ObjectNode{enabled:false}: ").append(body.get()).append("\n");
+
+        RestClient.Builder b2 = builder.clone();
+        MockRestServiceServer server2 = MockRestServiceServer.bindTo(b2).build();
+        AtomicReference<String> body2 = new AtomicReference<>();
+        server2.expect(requestTo("http://probe/y"))
+              .andExpect(req -> body2.set(((MockClientHttpRequest) req).getBodyAsString()))
+              .andRespond(withSuccess());
+        b2.build().post().uri("http://probe/y").contentType(MediaType.APPLICATION_JSON)
+              .body(Map.of("at", Instant.parse("2026-09-30T12:00:00Z"))).retrieve().toBodilessEntity();
+        sb.append(" RestClient wire body for Map{at:Instant}: ").append(body2.get()).append("\n");
+        System.out.println(sb);
+    }
+}
+
+@SpringBootTest
+@ActiveProfiles("test")
+class BootSpikeJacksonProbeDefaultTest extends BootSpikeJacksonProbeBase {}
+
+@SpringBootTest(properties = "spring.http.converters.preferred-json-mapper=jackson2")
+@ActiveProfiles("test")
+class BootSpikeJacksonProbeJackson2Test extends BootSpikeJacksonProbeBase {}
diff --git a/core-java/src/test/java/uk/jtoye/core/spike/BootSpikePropertyAuditTest.java b/core-java/src/test/java/uk/jtoye/core/spike/BootSpikePropertyAuditTest.java
new file mode 100644
index 00000000..ab265aa4
--- /dev/null
+++ b/core-java/src/test/java/uk/jtoye/core/spike/BootSpikePropertyAuditTest.java
@@ -0,0 +1,64 @@
+package uk.jtoye.core.spike;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.configurationmetadata.ConfigurationMetadataProperty;
+import org.springframework.boot.configurationmetadata.ConfigurationMetadataRepository;
+import org.springframework.boot.configurationmetadata.ConfigurationMetadataRepositoryJsonBuilder;
+import org.springframework.boot.env.YamlPropertySourceLoader;
+import org.springframework.core.env.EnumerablePropertySource;
+import org.springframework.core.env.PropertySource;
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.core.io.Resource;
+import org.springframework.core.io.support.PathMatchingResourcePatternResolver;
+
+import java.io.InputStream;
+import java.util.Map;
+import java.util.TreeSet;
+
+/** SPIKE ONLY: static audit of application*.yml keys against Boot 4.1.1 configuration metadata. */
+class BootSpikePropertyAuditTest {
+    @Test
+    void audit() throws Exception {
+        ConfigurationMetadataRepositoryJsonBuilder b = ConfigurationMetadataRepositoryJsonBuilder.create();
+        Resource[] metas = new PathMatchingResourcePatternResolver()
+                .getResources("classpath*:META-INF/spring-configuration-metadata.json");
+        for (Resource r : metas) { try (InputStream in = r.getInputStream()) { b.withJsonResource(in); } }
+        Resource[] extra = new PathMatchingResourcePatternResolver()
+                .getResources("classpath*:META-INF/additional-spring-configuration-metadata.json");
+        for (Resource r : extra) { try (InputStream in = r.getInputStream()) { b.withJsonResource(in); } }
+        ConfigurationMetadataRepository repo = b.build();
+        Map<String, ConfigurationMetadataProperty> all = repo.getAllProperties();
+        StringBuilder sb = new StringBuilder("\nSPIKE-PROPS metadata files=" + metas.length + " properties=" + all.size() + "\n");
+        String[] files = {"application.yml", "application-dev.yml", "application-local.yml",
+                "application-prod.yml", "application-staging.yml", "application-test.yml"};
+        TreeSet<String> deprecated = new TreeSet<>(), unknown = new TreeSet<>();
+        int checked = 0;
+        for (String f : files) {
+            for (PropertySource<?> ps : new YamlPropertySourceLoader().load(f, new ClassPathResource(f))) {
+                for (String key : ((EnumerablePropertySource<?>) ps).getPropertyNames()) {
+                    String k = key.replaceAll("\\[\\d+\\]$", "");
+                    if (!k.matches("^(spring|management|server|logging)\\..*")) continue;
+                    checked++;
+                    ConfigurationMetadataProperty p = all.get(k);
+                    if (p == null) {
+                        // map-typed parents (e.g. spring.jpa.properties.*) are legitimately absent: find a map ancestor
+                        String parent = k; boolean mapParent = false;
+                        while (parent.contains(".")) {
+                            parent = parent.substring(0, parent.lastIndexOf('.'));
+                            ConfigurationMetadataProperty pp = all.get(parent);
+                            if (pp != null && pp.getType() != null && (pp.getType().startsWith("java.util.Map") || pp.getType().startsWith("java.util.List"))) { mapParent = true; break; }
+                        }
+                        if (!mapParent) unknown.add(f + " : " + k);
+                    } else if (p.isDeprecated()) {
+                        deprecated.add(f + " : " + k + " -> replacement=" + p.getDeprecation().getReplacement()
+                                + " level=" + p.getDeprecation().getLevel() + " reason=" + p.getDeprecation().getReason());
+                    }
+                }
+            }
+        }
+        sb.append(" checked keys=").append(checked).append("\n");
+        deprecated.forEach(s -> sb.append(" DEPRECATED ").append(s).append("\n"));
+        unknown.forEach(s -> sb.append(" UNKNOWN ").append(s).append("\n"));
+        System.out.println(sb);
+    }
+}
