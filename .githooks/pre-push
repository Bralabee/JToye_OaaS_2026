#!/usr/bin/env bash
# pre-push — refuse a push that is already known to be wrong, before it lands.
#
# HOW THIS RUNS
#   Reached through the global dispatcher (`core.hooksPath = ~/.git-hooks`), which
#   delegates to this file because it is committed executable. There is nothing to
#   configure; `scripts/install-hooks.sh --check` asserts the mode-100755 bit against
#   git's INDEX, because a hook without it is skipped SILENTLY and that is
#   indistinguishable from a hook that ran and had nothing to say.
#
# WHY ONLY THESE FOUR, WHEN CI ALREADY RUNS SIX WORKFLOWS
#   This repo is PUBLIC, so Actions are free and CI is the right home for anything
#   slow. A pre-push check earns its place only if it is fast, offline, and either
#   (a) impossible to undo once the push lands, or (b) load-bearing enough that
#   discovering it as a red PR is the more expensive path. Nothing here compiles,
#   starts a container, or touches the network beyond one `git ls-remote`.
#
#   P-1  direct push to the base branch
#        The project's first git rule is feature-branch-only. `block-main-branch.sh`
#        already guards the Claude Code Bash tool — but only that path. A push typed
#        into a terminal, or made by any other tool, has never been gated. This is
#        the half of the rule that was enforced nowhere.
#
#   P-2  branch behind its base            (scripts/check-branch-behind-base.sh)
#        DELIBERATELY DUPLICATED from ci-cd.yaml. Phase 26's runtime was verified
#        green while the branch sat three commits behind origin/main, so the image
#        was missing three merged PRs and no rebuild could have added them. Catching
#        that here costs a second; catching it as a red PR costs a round trip.
#
#   P-4  documented claims match their sources    (scripts/check-claims.sh)
#        The vendored claim-gate over scripts/gates/claims.manifest: every count the
#        docs assert, bound to the file that decides it. Fast (greps over tracked
#        files), fully offline, and its failure IS the cheap-to-catch-here kind — a
#        drifted doc number discovered as a red PR costs a round trip; here it costs
#        a second. Ran only in CI until 2026-08-30 (the dotfiles installer's check
#        printed "no local trigger" on every --check). VOID (rc 2) BLOCKS: "could
#        not verify the claims" must never read as "verified".
#
#   P-3  secrets in the commits being pushed
#        The one check that CANNOT be left to CI. gitleaks.yml runs AFTER the push,
#        and on a public repo a secret is compromised the instant it lands — a red
#        job is then a notification, not a gate. Scanned over the pushed RANGE only,
#        never the whole history, so it stays fast.
#
# WHAT IS DELIBERATELY NOT HERE
#   The Gradle build, the Testcontainers suite, the frontend typecheck and the E2E
#   run. All are minutes of wall-clock and some need docker; blocking a push on them
#   is how a hook gets bypassed with --no-verify until nobody remembers it exists.
#   They belong to ci-cd.yaml and e2e-nightly.yml, which already own them.
#
#   Code review is NOT a blocking check here, and that is a deliberate call. An LLM
#   reviewer is a FINDER, not a gate: its fail direction is not reproducible, so the
#   same diff can pass one run and flag the next. A gate you cannot demonstrate
#   failing on demand is not a gate. It is printed as an advisory instead.
#
# BYPASS
#   `git push --no-verify`. Git already provides one; this hook deliberately adds no
#   second escape hatch of its own.
#
# SELFTEST
#   `.githooks/pre-push --selftest` runs the fail-direction battery. Every arm below
#   is proven able to FIRE before any of it is trusted — a check only ever observed
#   passing may be incapable of failing.
#
# EXIT: 0 = allow · 1 = refused

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
GITLEAKS_CONFIG_PATH="$REPO_ROOT/.gitleaks.toml"
BEHIND_GATE="$REPO_ROOT/scripts/check-branch-behind-base.sh"
CLAIMS_GATE="$REPO_ROOT/scripts/check-claims.sh"

FAILED=0
red()  { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
ok()   { printf '  ok    %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*" >&2; FAILED=$((FAILED + 1)); }
skip() { printf '  skip  %s\n' "$*"; }

# Resolve the base branch the same way check-branch-behind-base.sh does — never
# hardcode `main`, which would mis-assert on a fork, rename or release branch.
resolve_base() {
    local b
    b="${BASE_REF:-}"
    [ -n "$b" ] && { printf '%s' "$b"; return; }
    b="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null | sed 's|^refs/remotes/origin/||')"
    [ -n "$b" ] && { printf '%s' "$b"; return; }
    printf 'main'
}

# ── P-1 ───────────────────────────────────────────────────────────────────────
# Refuse a push whose DESTINATION is the base branch. Asserted on the remote ref
# git hands us, not on the local branch name: pushing HEAD:main from a feature
# branch is the same violation and a local-name check would wave it through.
check_no_base_push() {
    local remote_ref="$1" base="$2"
    case "$remote_ref" in
        "refs/heads/$base")
            bad "P-1 refusing to push directly to '$base' — this project is feature-branch-only."
            printf '        open a PR instead:  git switch -c feature/<name>\n' >&2
            return 1 ;;
    esac
    return 0
}

# ── P-2 ───────────────────────────────────────────────────────────────────────
check_not_behind() {
    if [ ! -x "$BEHIND_GATE" ]; then
        skip "P-2 branch-behind-base — $BEHIND_GATE not executable"
        return 0
    fi
    local out rc
    out="$(bash "$BEHIND_GATE" 2>&1)"; rc=$?
    case "$rc" in
        0) ok "P-2 branch contains every commit on its base" ;;
        2) skip "P-2 branch-behind-base VOID (base unresolvable — offline?) — no opinion, NOT a pass" ;;
        *) bad "P-2 this branch is BEHIND its base"
           printf '%s\n' "$out" | tail -6 >&2
           printf '        fix:  git fetch origin && git merge origin/%s\n' "$(resolve_base)" >&2 ;;
    esac
    return 0
}

# ── P-3 ───────────────────────────────────────────────────────────────────────
# Scans the pushed range only. A missing binary is a SKIP, never a silent pass:
# the operator is told the check did not run, which is not the same as clean.
check_secrets() {
    local range="$1"
    if ! command -v gitleaks >/dev/null 2>&1; then
        warn "  skip  P-3 gitleaks not installed — secrets NOT scanned (this is not a pass)"
        printf '        install: https://github.com/gitleaks/gitleaks#installing\n' >&2
        return 0
    fi
    [ -n "$range" ] || { skip "P-3 no commit range to scan"; return 0; }
    local out rc cfg=()
    [ -f "$GITLEAKS_CONFIG_PATH" ] && cfg=(--config "$GITLEAKS_CONFIG_PATH")
    out="$(gitleaks git "${cfg[@]}" --log-opts "$range" --no-banner --redact 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then
        ok "P-3 no secrets in the commits being pushed"
    else
        bad "P-3 gitleaks found a secret in the commits being pushed"
        printf '%s\n' "$out" | tail -20 >&2
        printf '        a public repo leaks it the instant the push lands — CI cannot undo that.\n' >&2
    fi
    return 0
}

# ── P-4 ───────────────────────────────────────────────────────────────────────
# The documented-claims gate. Exit contract of check-claims.sh: 0 match · 1 a
# claim drifted · 2 VOID, could not check. BOTH nonzero shapes block — a VOID
# read as a pass is exactly the vacuous-check class the gate exists to kill.
# A missing/non-executable gate is a SKIP said out loud (a repo mid-bootstrap
# is not a failure), never a silent pass.
check_claims() {
    if [ ! -x "$CLAIMS_GATE" ]; then
        skip "P-4 documented-claims gate — $CLAIMS_GATE not executable (claims NOT checked; not a pass)"
        return 0
    fi
    local out rc
    out="$(bash "$CLAIMS_GATE" 2>&1)"; rc=$?
    case "$rc" in
        0) ok "P-4 documented claims match their sources" ;;
        1) bad "P-4 a documented claim drifted from its source of truth"
           printf '%s\n' "$out" | tail -8 >&2
           printf '        fix the doc or the source, never the manifest.\n' >&2 ;;
        *) bad "P-4 claim gate VOID (rc=$rc) — could not verify, which is NOT verified"
           printf '%s\n' "$out" | tail -4 >&2 ;;
    esac
    return 0
}

# ── advisory ──────────────────────────────────────────────────────────────────
advise_review() {
    local range="$1"
    printf '\n  note  code review is advisory here, not a gate. Before opening the PR:\n'
    printf '          /code-review              review the working diff\n'
    printf '          /code-review high         broader coverage, may include uncertain findings\n'
    if [ -n "$range" ]; then
        printf '        range being pushed: %s (%s commit(s))\n' \
            "$range" "$(git rev-list --count "$range" 2>/dev/null || echo '?')"
    fi
}

# ── selftest ──────────────────────────────────────────────────────────────────
# Each arm must FIRE. An arm that has only ever been seen passing proves nothing.
selftest() {
    local pass=0 miss=0
    arm() { local name="$1" want="$2"; shift 2
        local out; out="$("$@" 2>&1)"
        if grep -q -- "$want" <<< "$out"; then printf 'ok    arm fires: %s\n' "$name"; pass=$((pass+1))
        else printf 'FAIL  arm SILENT: %s (out=%s)\n' "$name" "$(head -1 <<< "$out")"; miss=$((miss+1)); fi; }

    echo "── pre-push fail-direction battery ──"

    # A1/A2: P-1 must refuse the base ref and must allow a feature ref.
    arm "P-1 refuses a push to the base branch" "P-1 refusing" \
        check_no_base_push "refs/heads/$(resolve_base)" "$(resolve_base)"
    local out; out="$(check_no_base_push refs/heads/feature/x "$(resolve_base)" 2>&1)"
    if [ -z "$out" ]; then printf 'ok    arm fires: P-1 allows a feature branch (no false positive)\n'; pass=$((pass+1))
    else printf 'FAIL  arm SILENT: P-1 wrongly refused a feature branch (%s)\n' "$out"; miss=$((miss+1)); fi

    # A3/A4: P-3 must report a planted secret in a real commit range, and must NOT
    # report one in a clean range. Both directions, or the arm proves only that
    # gitleaks returns some number.
    #
    # The fixture is GENERATED AT RUNTIME, never written as a literal here: a
    # matchable token sitting in this file would make the repo's own gitleaks.yml
    # fail on the hook that exists to catch secrets. It is a 40-char GitHub-PAT
    # shape (prefix + exactly 36 random chars) — verified 2026-08-24 to fire on
    # gitleaks 8.30.1, where the documented AWS *example* key does NOT, because
    # that one is allowlisted by the default config. A fixture the scanner
    # deliberately ignores is how this arm silently passed on first write.
    if command -v gitleaks >/dev/null 2>&1; then
        local T; T="$(mktemp -d)"
        local tok; tok="gh""p_$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 36)"
        (
            cd "$T" || exit 1
            git init -q . && git config user.email t@t && git config user.name t
            echo baseline > a.txt && git add a.txt && git commit -qm base
            echo "clean change" >> a.txt && git add a.txt && git commit -qm clean
            printf 'token = %s\n' "$tok" > leak.txt
            git add leak.txt && git commit -qm leak
        ) >/dev/null 2>&1

        local lrc crc
        (cd "$T" && gitleaks git --log-opts "HEAD~1..HEAD" --no-banner --redact >/dev/null 2>&1); lrc=$?
        if [ "$lrc" -ne 0 ]; then printf 'ok    arm fires: P-3 detects a planted secret (rc=%s)\n' "$lrc"; pass=$((pass+1))
        else printf 'FAIL  arm SILENT: P-3 passed a planted credential — the fixture may be allowlisted\n'; miss=$((miss+1)); fi

        (cd "$T" && gitleaks git --log-opts "HEAD~2..HEAD~1" --no-banner --redact >/dev/null 2>&1); crc=$?
        if [ "$crc" -eq 0 ]; then printf 'ok    arm fires: P-3 clean range stays clean (no false positive)\n'; pass=$((pass+1))
        else printf 'FAIL  arm SILENT: P-3 flagged a clean range (rc=%s) — it would block every push\n' "$crc"; miss=$((miss+1)); fi
        rm -rf "$T"
    else
        printf 'skip  P-3 arms — gitleaks not installed\n'
    fi

    # A4: P-2 must be reachable and must not fail closed when it cannot resolve a base.
    if [ -x "$BEHIND_GATE" ]; then printf 'ok    arm fires: P-2 gate is present and executable\n'; pass=$((pass+1))
    else printf 'FAIL  arm SILENT: P-2 gate missing at %s\n' "$BEHIND_GATE"; miss=$((miss+1)); fi

    # A5/A6: P-4 must FAIL on a drifted claim and must NOT fail on a matching one.
    # Hermetic: a runtime-built fixture repo drives the vendored ENGINE directly —
    # never this repo's real manifest, whose pass state is what main asserts.
    local CT; CT="$(mktemp -d)"
    printf 'v=2\n' > "$CT/src.txt"; printf 'version 2\n' > "$CT/doc.md"
    printf 'source\tv\tregex\tsrc.txt\tint\t^v=\\K[0-9]+\nrule\tv\t-\tdoc.md\tdoc version\tversion \\K[0-9]+\n' > "$CT/m.tsv"
    local prc brc
    (bash "$REPO_ROOT/scripts/gates/claim-gate.sh" -r "$CT" -m "$CT/m.tsv" >/dev/null 2>&1); prc=$?
    printf 'version 1\n' > "$CT/doc.md"
    (bash "$REPO_ROOT/scripts/gates/claim-gate.sh" -r "$CT" -m "$CT/m.tsv" >/dev/null 2>&1); brc=$?
    rm -rf "$CT"
    if [ "$brc" -eq 1 ]; then printf 'ok    arm fires: P-4 detects a drifted claim (rc=1)\n'; pass=$((pass+1))
    else printf 'FAIL  arm SILENT: P-4 passed a drifted claim (rc=%s)\n' "$brc"; miss=$((miss+1)); fi
    if [ "$prc" -eq 0 ]; then printf 'ok    arm fires: P-4 matching claim stays clean (no false positive)\n'; pass=$((pass+1))
    else printf 'FAIL  arm SILENT: P-4 flagged a matching claim (rc=%s) — it would block every push\n' "$prc"; miss=$((miss+1)); fi

    echo
    echo "arms firing: $pass · silent: $miss"
    [ "$miss" -eq 0 ]
}

# ── main ──────────────────────────────────────────────────────────────────────
if [ "${1:-}" = "--selftest" ]; then selftest; exit $?; fi

BASE="$(resolve_base)"
ZERO="0000000000000000000000000000000000000000"
RANGE=""
SAW_REF=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    # A delete has an all-zero LOCAL sha: nothing is being added, so nothing to scan.
    [ "$local_sha" = "$ZERO" ] && continue
    SAW_REF=1
    check_no_base_push "$remote_ref" "$BASE"
    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch on the remote: bound the scan by the base, never the whole history.
        if git rev-parse --verify --quiet "origin/$BASE" >/dev/null 2>&1; then
            RANGE="origin/$BASE..$local_sha"
        else
            RANGE="$local_sha~1..$local_sha"
        fi
    else
        RANGE="$remote_sha..$local_sha"
    fi
done

# Run by hand (empty stdin): still useful — assume the current branch against its base.
if [ "$SAW_REF" -eq 0 ]; then
    if git rev-parse --verify --quiet "origin/$BASE" >/dev/null 2>&1; then
        RANGE="origin/$BASE..HEAD"
    fi
fi

echo "pre-push verification (fast, offline; ci-cd.yaml owns the rest)"
check_not_behind
check_secrets "$RANGE"
check_claims

if [ "$FAILED" -gt 0 ]; then
    echo
    red "PUSH REFUSED — $FAILED check(s) failed."
    printf 'Fix the cause, or, if you are deliberately pushing unverified work:\n    git push --no-verify\n' >&2
    exit 1
fi

advise_review "$RANGE"
echo
echo "pre-push: all checks passed."
exit 0
