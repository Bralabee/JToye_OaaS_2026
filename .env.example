# J'Toye OaaS - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# PostgreSQL
POSTGRES_USER=jtoye
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jtoye

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Keycloak DB (shares PostgreSQL credentials)
KC_DB_USERNAME=jtoye
KC_DB_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# RabbitMQ
RABBITMQ_DEFAULT_USER=jtoye
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# Core Java API
DB_USER=jtoye_app
DB_PASSWORD=CHANGE_ME
RABBITMQ_USER=jtoye
RABBITMQ_PASSWORD=CHANGE_ME

# SMTP (Email Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS=true

# Email Notification Settings (docker-compose defaults to Mailhog)
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_TRACKING_BASE_URL=http://localhost:3000

# MinIO / S3 (Image Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jtoye-images
S3_PUBLIC_URL=http://localhost:9000/jtoye-images

# Frontend / NextAuth
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32
KEYCLOAK_CLIENT_ID=core-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
