# J'Toye OaaS - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Every CHANGE_ME below must be replaced with a value that is at least 8
# characters and is not a single dictionary word or a product's factory default.
# scripts/verify-env.sh enforces both and runs as a preflight in
# scripts/start-dev.sh, so the stack refuses to boot on a weak credential.
# That check exists because two of them shipped anyway (issues #438, #439):
# being SET was all that was ever verified, and both were set — to the default.

# Bind address for every published INFRASTRUCTURE port in the Compose stacks
# (issues #438 / #441). 127.0.0.1 publishes them on loopback only, which is what
# local development, Playwright and the browser all use.
#
# Leave this alone unless you specifically need off-host access — for example
# opening the storefront from a phone on the same network. Setting 0.0.0.0
# republishes the database, cache, broker, object storage, identity provider and
# the captured-email archive to every network this machine is attached to, so it
# is an explicit opt-in and scripts/check-infra-exposure.sh fails while it is on.
JTOYE_BIND_HOST=127.0.0.1

# PostgreSQL
POSTGRES_USER=jtoye
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jtoye

# Prometheus postgres-exporter (infra/monitoring/docker-compose.monitoring.yml)
# MUST be set — compose will fail fast if blank. Use a dedicated read-only role.
POSTGRES_EXPORTER_USER=jtoye
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME
# The compose Postgres runs WITHOUT TLS (`show ssl` -> off), so `require` makes the
# exporter connect and then fail its version query with
#   pq: SSL is not enabled on the server
# producing up{job="postgres"}=1 AND pg_up=0 — a target that looks healthy while
# collecting nothing, and a DatabaseDown alert that reports healthy while blind.
# Evidence: .planning/phases/27-operational-maturity/baselines/B-6.txt
# Any deployment whose Postgres has TLS should set `require` (or `verify-full`).
# The compose default at docker-compose.monitoring.yml:118 deliberately stays
# `require` (fail-secure) — this file is what a local dev copies.
POSTGRES_EXPORTER_SSLMODE=disable

# Prometheus scrape target for the core-java actuator (phase 27, plan 27-00).
# The port DIFFERS BY RUNTIME and is therefore injected, not hardcoded:
#   dev/compose — 9090, the app port; SPRING_PROFILES_ACTIVE=dev sets no
#                 management.server.port, and the scrape endpoint is opted in via
#                 MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE
#   prod/k8s    — 9091, a separate internal management port
#                 (application-prod.yml:106-107); k8s carries its own
#                 prometheus.io/port annotation and does not read this key
# Rendered into prometheus.yml at container start by prometheus/entrypoint.sh.
# If you override SERVER_PORT or MANAGEMENT_SERVER_PORT, change this to match or the
# target goes down and eight alerts go blind.
CORE_JAVA_METRICS_PORT=9090

# Prometheus scrape target for the edge gateway, AND the port the edge serves
# /metrics on (issue #550, SEC-02/C4). ONE key feeds both sides:
#   docker-compose.full-stack.yml  edge-go.environment.EDGE_MANAGEMENT_PORT
#   infra/monitoring/...monitoring.yml  prometheus.environment.EDGE_GO_METRICS_PORT
# so the listener and the scrape target cannot drift apart.
# WHY IT IS NOT 8080: 8080 is the edge's application port, published as 8089 on all
# interfaces (a named app-tier exemption), so /metrics there was reachable with no
# credentials and disclosed the gateway's route templates. With this set, edge-go
# serves /metrics ONLY on the management listener, which is deliberately NOT
# published to the host — Prometheus reaches it over the compose network.
# Leaving it EMPTY is not "the safe default": empty puts /metrics back on the
# published app port, which is the exposure itself.
EDGE_GO_METRICS_PORT=9101

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Keycloak user deprovisioning on tenant offboard (issue #102 remainder).
# OFF by default: the core service disables an offboarded tenant's Keycloak
# users (identity-layer complement to the API 403) only when enabled=true AND a
# base-url is set. KC_ADMIN_BASE_URL must be the IN-CLUSTER Keycloak host
# reachable from core (e.g. http://keycloak:8080) — NOT the public
# localhost:8085. Credentials reuse KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD above.
KC_ADMIN_ENABLED=false
KC_ADMIN_BASE_URL=http://keycloak:8080
# Comma-separated realms to sweep. Vendor realm only by default: the customer
# realm has no tenant_id user attributes.
KC_DEPROVISION_REALMS=jtoye-dev

# Keycloak DB (shares PostgreSQL credentials)
KC_DB_USERNAME=jtoye
KC_DB_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# RabbitMQ
RABBITMQ_DEFAULT_USER=jtoye
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# Core Java API
#
# THREE database roles, and which one goes where (SEC-04 / #552, D-01):
#   jtoye_runtime  the application's DML-only role — RLS applies to it and it owns
#                  nothing. This is what the app (Hikari pool) connects as, via
#                  DB_USER / DB_PASSWORD below.
#   jtoye_app      the owner/migrator — holds CREATE on the schema and runs Flyway.
#                  Reached via DB_MIGRATION_USER / DB_MIGRATION_PASSWORD.
#   the superuser  (POSTGRES_USER) — for NEITHER: it BYPASSES Row-Level Security and
#                  core-java refuses to boot as it.
# An environment that has not adopted the split may instead set DB_USER=jtoye_app
# and omit the DB_MIGRATION_* pair; application.yml's defaults then keep behaviour
# identical. Provision jtoye_runtime with infra/db/create-runtime-role.sql
# (existing volume) or automatically via infra/db/init/00-create-db.sql (fresh).
DB_USER=jtoye_runtime
DB_PASSWORD=CHANGE_ME
# Flyway migrates as the OWNER role; keep this jtoye_app. Setting it to
# jtoye_runtime means Flyway has no CREATE and the app never boots on a fresh DB.
DB_MIGRATION_USER=jtoye_app
DB_MIGRATION_PASSWORD=CHANGE_ME
RABBITMQ_USER=jtoye
RABBITMQ_PASSWORD=CHANGE_ME

# RabbitMQ listener tuning (Phase 27 / 27-04). Names only — none of these is a credential.
# Bound by RabbitListenerProperties under jtoye.rabbit.*; see docs/runbooks/messaging.md.
# NOTE these are deliberately NOT spring.rabbitmq.listener.simple.* — that family is inert in
# this project because a bean named rabbitListenerContainerFactory makes Boot's factory back off.
# Prefetch for the eight non-media queues. 250 is today's effective container default.
JTOYE_RABBIT_DEFAULT_PREFETCH=250
# Consumers per non-media queue. Keep at 1: >1 loses per-order ordering on order.state-changes.
JTOYE_RABBIT_DEFAULT_CONCURRENCY=1
# media.process prefetch. Low by intent — at 250 one replica hoards a burst while others idle.
JTOYE_RABBIT_MEDIA_PREFETCH=2
# media.process starting consumers. 1 saturates one core at a measured 606 ms/message.
JTOYE_RABBIT_MEDIA_CONCURRENCY=1
# media.process ceiling under sustained backlog. 2 is the most both connection budgets allow.
JTOYE_RABBIT_MEDIA_MAX_CONCURRENCY=2

# Outbox flusher tuning (Phase 27 / 27-04). Previously bound ONLY as inline @Value defaults with
# no key anywhere, so changing a flush interval in production required rebuilding the image.
# Values here are identical to those defaults — this is a visibility fix, not a behaviour change.
# MEDIA_OUTBOX_FLUSH_INTERVAL_MS paces the whole media pipeline: arrival is batched on it.
PAYMENT_OUTBOX_FLUSH_INTERVAL_MS=5000
PAYMENT_OUTBOX_RESURRECT_INTERVAL_MS=300000
PAYMENT_OUTBOX_BACKOFF_BASE_MS=5000
PAYMENT_OUTBOX_BACKOFF_CAP_MS=300000
MEDIA_OUTBOX_FLUSH_INTERVAL_MS=5000
MEDIA_OUTBOX_RESURRECT_INTERVAL_MS=300000
MEDIA_OUTBOX_BACKOFF_BASE_MS=5000
MEDIA_OUTBOX_BACKOFF_CAP_MS=300000

# SMTP (Email Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS=true

# Email Notification Settings (docker-compose defaults to Mailhog)
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_TRACKING_BASE_URL=http://localhost:3000

# MinIO / S3 (Image Storage)
# Rotate both — MINIO_ROOT_USER/PASSWORD are the S3 credentials for minio AND the
# core-java S3 client (S3_ACCESS_KEY/S3_SECRET_KEY). Compose fails loud if unset.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=jtoye-images
S3_PUBLIC_URL=http://localhost:9000/jtoye-images
# Image tags — PIN TO A SPECIFIC RELEASE IN PRODUCTION
# Browse releases at https://github.com/minio/minio/releases and https://github.com/ollama/ollama/releases
# Leaving these blank falls back to :latest which breaks reproducibility.
MINIO_IMAGE_TAG=
# minio-init runs mc with the ROOT object-storage credentials, so pin it by DIGEST (#270),
# not just a tag: a tag is mutable and would run whatever `latest` resolves to next with full
# bucket authority. The name:tag@sha256 form keeps the human-readable release AND the immutable
# digest on one reviewable line; a wrong digest fails the pull loudly. Re-resolve after a
# deliberate upgrade with: docker inspect --format '{{index .RepoDigests 0}}' minio/mc:<tag>
MINIO_MC_IMAGE_TAG=RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
OLLAMA_IMAGE_TAG=

# AI Image Analysis
AI_PROVIDER=ollama                    # "ollama" (free, local) or "anthropic" (paid, cloud)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b                 # gemma3:12b recommended (llava:7b may crash on some GPUs)
# HOST-side publish port for the ollama container. Default 11435, NOT 11434, because a
# host-native `ollama serve` (systemd) binds 11434 and the container then cannot start at
# all — Docker fails "address already in use", aborts networking setup, and leaves the
# container attached to NO network while still reporting healthy (its healthcheck runs
# inside itself). Nothing in the stack reads this port: core-java and ollama-init both use
# http://ollama:11434 over the bridge network. Set to 11434 only if no host ollama runs.
OLLAMA_HOST_PORT=11435
# How long the vision model stays resident in VRAM after its last request.
# ollama's own default is 5m, which meant a burst of image analysis more than five
# minutes after the last one paid a full cold load: measured 71 996ms, of which
# 71 891ms was loading 8 GB from disk into VRAM (the eval was 21ms). Warm: ~400ms.
# -1 = keep loaded indefinitely (the default here). Costs ~10 GB of VRAM for the life
# of the container, so lower it to a duration ("30m", "2h") if a desktop shares the
# GPU, or "0" to unload after every request.
OLLAMA_KEEP_ALIVE=-1
# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Stripe Payment Processing
# sk_test_... from Stripe dashboard
STRIPE_API_KEY=
# whsec_... from Stripe webhook settings
STRIPE_WEBHOOK_SECRET=
# pk_test_... from Stripe dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Edge rate limiter (Go gateway)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Frontend / NextAuth
# Generate a fresh secret with:  openssl rand -hex 32
# Do NOT reuse across environments; rotate on suspected compromise.
NEXTAUTH_SECRET=CHANGE_ME
KEYCLOAK_CLIENT_ID=core-api
# KEYCLOAK_CLIENT_SECRET ALSO renders the realm core-api client secret at Keycloak
# import (via the keycloak-realm-render sidecar), so the realm-side and frontend-side
# secrets are provably identical. Generate with: openssl rand -hex 32
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# Keycloak realm render (issue #80) — consumed by the keycloak-realm-render sidecar
# that renders infra/keycloak/realm-export.json from realm-export.template.json.
# EDGE_API_CLIENT_SECRET renders the realm edge-api client secret.
# KC_SEED_USER_PASSWORD renders the seed-user (tenant-a-user/tenant-b-user/admin-user)
# login password. Generate each with: openssl rand -hex 32
EDGE_API_CLIENT_SECRET=CHANGE_ME
KC_SEED_USER_PASSWORD=CHANGE_ME
# INTEGRATION_CATALOG_RO_SECRET renders the realm integration-catalog-ro machine client
# secret (issue #206 [AI-4]): the read-only catalog client-credentials sample.
INTEGRATION_CATALOG_RO_SECRET=CHANGE_ME
# INTEGRATION_ORDERS_RW_SECRET renders the realm integration-orders-rw machine client
# secret (Phase 25 [AI-02] / #204): the read-write orders+customers client-credentials
# sample (orders:write + customers:write + catalog:read). Generate: openssl rand -hex 32
INTEGRATION_ORDERS_RW_SECRET=CHANGE_ME

# Customer identity realm (jtoye-customers) — Phase 18 B2C/B2B split.
# Consumed by the keycloak-realm-render sidecar (renders infra/keycloak/realm-export-customers.json
# from realm-export-customers.template.json) and by the frontend customer-auth path.
# These are NON-SECRET local-dev config values (URLs / flags), so they may be committed.
# CUSTOMER_STOREFRONT_REDIRECT_URIS / _WEB_ORIGINS are JSON-array element lists that expand
# inside the template's `[ ]`. Single-quote the WHOLE value so compose + envsubst preserve the
# inner double quotes verbatim. Includes the port-3100 workaround (MCP holds :3000) plus 3000/3001.
CUSTOMER_STOREFRONT_REDIRECT_URIS='"http://localhost:3000/*", "http://localhost:3001/*", "http://localhost:3100/*"'
CUSTOMER_STOREFRONT_WEB_ORIGINS='"http://localhost:3000", "http://localhost:3001", "http://localhost:3100"'
# verifyEmail default OFF for local dev (least-friction headless registration). Set true in prod.
CUSTOMER_VERIFY_EMAIL=false
# Browser build arg (inlined into the frontend bundle at BUILD time) + server/runtime issuers.
NEXT_PUBLIC_CUSTOMER_KEYCLOAK_URL=http://localhost:8085/realms/jtoye-customers
# Phase 21 (ONBD-05/03): onboarding support channel + review SLA. Browser build args
# (inlined at BUILD time) surfaced on the vendor onboarding page for REJECTED/SUSPENDED
# support + the "in review" SLA copy. NEXT_PUBLIC_SUPPORT_URL wins over the email when
# both are set; leave one blank to use the other. Compose supplies dev defaults.
NEXT_PUBLIC_SUPPORT_EMAIL=support@olajay.co.uk
NEXT_PUBLIC_SUPPORT_URL=https://help.olajay.co.uk/onboarding
NEXT_PUBLIC_ONBOARDING_REVIEW_SLA_DAYS=2
CUSTOMER_KEYCLOAK_ISSUER=http://localhost:8085/realms/jtoye-customers
CUSTOMER_KEYCLOAK_ISSUER_INTERNAL=http://keycloak:8080/realms/jtoye-customers
CUSTOMER_KEYCLOAK_CLIENT_ID=storefront-client
# Google identity provider for the CUSTOMER realm (#432 / CUST-03) — OPTIONAL, and
# deliberately EMPTY. The IdP ships `enabled: false` per
# docs/architecture/decisions/ADR-0005-customer-realm-identity-providers.md: Google
# requires HTTPS on a resolving host for any non-localhost redirect URI, and
# jtoye.co.uk currently answers only a registrar parking page over http.
#
# Leave BOTH blank unless you are deliberately enabling the IdP. scripts/verify-env.sh
# requires them only when the realm template has the provider enabled, so the default
# stack boots with neither set.
#
# To enable: set both here, flip `enabled` to true in
# infra/keycloak/realm-export-customers.template.json, register
# {keycloak-public-url}/realms/jtoye-customers/broker/google/endpoint in the Google
# Cloud console (no wildcards, no raw IPs), then REPLACE the realm — `--import-realm`
# skips a realm that already exists. Procedure: infra/keycloak/README.md.
#
# GOOGLE_CLIENT_SECRET is a real secret. It renders into the gitignored
# realm-export-customers.json and must never be committed.
#
# Write these as a bare `NAME=` with nothing after the `=`. A trailing `# comment` on
# the SAME line is not a comment to a shell — `VAR=  # note` assigns the comment text,
# and an is-configured guard then reads the variable as CONFIGURED.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# STOMP Broker Relay (Phase 11 -- horizontal scaling)
# Set to "relay" for multi-replica mode, "in-memory" for single-replica dev
STOMP_BROKER_MODE=in-memory

# Alertmanager email routing (phase 9)
# Defaults assume Mailhog is running on the jtoye-network (docker-compose.full-stack.yml).
# For prod, point SMARTHOST at a real SMTP relay (smtp.sendgrid.net:587, etc.), set
# REQUIRE_TLS=true, and supply SMTP_AUTH_USERNAME/SMTP_AUTH_PASSWORD via a follow-up.
# Alertmanager renders these into alertmanager.yml at container start via entrypoint.sh.
ALERTMANAGER_SMTP_SMARTHOST=mailhog:1025
ALERTMANAGER_SMTP_FROM=alerts@jtoye.local
ALERTMANAGER_SMTP_TO=ops@jtoye.local
ALERTMANAGER_SMTP_REQUIRE_TLS=false

# Alertmanager Slack routing (phase 27, additive — email remains the default route).
# Leave EMPTY to omit the Slack receiver entirely. A value containing PLACEHOLDER /
# CHANGE_ME / example.com is treated as UNSET (rendering it would point Alertmanager
# at a dead URL and every notification to it would fail).
ALERTMANAGER_SLACK_WEBHOOK_URL=
ALERTMANAGER_SLACK_CHANNEL=#jtoye-alerts

# Alertmanager NOTIFICATION mute — LOCAL DEVELOPMENT ONLY. Comma-separated alert
# NAMES (not label matchers): a value that is not a bare alertname is FATAL at
# container start rather than silently ignored.
#
# This withholds the notification. It does NOT stop the rule evaluating, and the
# alert still shows as firing in Prometheus and in the Alertmanager UI — nothing
# here can hide an alert from someone looking at one.
#
# Intended value locally:  ALERTMANAGER_MUTE_ALERTNAMES=NoOrdersCreated
#   NoOrdersCreated fires ~30 minutes after the last order. On a quiet dev stack
#   that is permanent noise, and the alternative remedy
#   (FORCE=1 scripts/seed-order-metric.sh) buys silence by writing a real order row
#   into the dev database each time. In production the alert is correct and wanted,
#   so this MUST stay empty there — scripts/check-alert-mute.sh assertion M-5 fails
#   the build if any file under k8s/ sets it.
ALERTMANAGER_MUTE_ALERTNAMES=

# Grafana admin credentials (infra/monitoring/docker-compose.monitoring.yml)
#
# GRAFANA_ADMIN_PASSWORD must NOT be left at Grafana's own factory default —
# that is issue #439, and it was live. The variable was always injected from
# here, so nothing that read the compose file could see the problem; the check
# that catches it interrogates the running instance instead
# (scripts/check-infra-exposure.sh, assertion C).
#
# Grafana applies this value ONLY when it first creates the admin user. If
# grafana_data already holds one, changing this line has no effect at all — reset
# it against the running container instead:
#   docker exec jtoye-grafana grafana cli admin reset-admin-password <new>
# then re-run the assertion. Editing this file and restarting is the shape of fix
# that looks complete and changes nothing.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Database backup job (infra/backups/backup.sh, Issue #119)
# See docs/runbooks/backups.md for the full runbook + restore-testing cadence.
# MIN_BACKUP_BYTES: reject any compressed dump smaller than this as invalid.
MIN_BACKUP_BYTES=1000
# METRICS_TEXTFILE_DIR: directory a node-exporter textfile collector scrapes.
# Leave BLANK to disable the metrics sink (no hard dependency on a collector).
METRICS_TEXTFILE_DIR=
# PUSHGATEWAY_URL: Prometheus Pushgateway base URL (no trailing /metrics).
# Leave BLANK to disable the push sink.
PUSHGATEWAY_URL=

# =============================================================================
# LOCAL KUBERNETES REHEARSAL (Phase 26 / INFRA-01)
#
# Consumed ONLY by scripts/lib/k8s-local-guards.sh, scripts/k8s-local-secrets.sh
# and scripts/k8s-local-up.sh. Nothing here is read by docker-compose or by
# scripts/verify-env.sh — the compose dev path is unaffected and stays working
# with these keys absent (deliberate: making a k8s-local-only key mandatory for
# every `scripts/start-dev.sh` run would regress a working path).
#
# WHY THESE EXIST AS KEYS AT ALL: the local overlay points every pod at the
# SHARED compose backing services over the pod host, so the scripts need the
# published host ports. Keeping them here rather than in the scripts means a
# compose port shift is a one-file fix (GLOBAL_RULE_6 / ARCHITECTURE_RULE_8) and
# no script contains an environment-varying host or port literal.
#
# COMPOSE XOR K8S: run compose OR a local minikube, never both — they share the
# dev Postgres. scripts/k8s-local-up.sh enforces that as a hard guard.
# =============================================================================

# Pod-side hostname for the compose backing services. minikube's docker driver
# resolves this to the host gateway; it is what k8s/local/configmap-patch.yaml
# shims all eight endpoints to.
K8S_LOCAL_POD_HOST=host.minikube.internal

# Published host ports of the compose backing services. Defaults track
# docker-compose.full-stack.yml: postgres ports (5433:5432), keycloak (8085:8080),
# redis (6379), rabbitmq (5672 AMQP + 61613 STOMP), minio (9000 S3 API),
# mailhog (1025 SMTP). Change here if a published port moves there.
K8S_LOCAL_DB_PORT=5433
K8S_LOCAL_KC_PORT=8085
K8S_LOCAL_REDIS_PORT=6379
K8S_LOCAL_AMQP_PORT=5672
K8S_LOCAL_STOMP_PORT=61613
K8S_LOCAL_MINIO_PORT=9000
K8S_LOCAL_SMTP_PORT=1025

# The ONLY kubectl context this tooling will ever target. The guard refuses
# unless this context exists AND its API-server host equals the minikube
# profile's node IP — so a same-named context pointing elsewhere is still
# rejected, and a stray non-local context can never be applied to.
# `kubectl config use-context` is never called.
K8S_LOCAL_KUBE_CONTEXT=jtoye

# minikube profile name + the size the 2026-07-14 rehearsal used (and the size
# the existing profile is already configured with).
K8S_LOCAL_MINIKUBE_PROFILE=jtoye
K8S_LOCAL_MINIKUBE_CPUS=4
K8S_LOCAL_MINIKUBE_MEMORY=12g

# Bucket the pg-backup CronJob uploads dumps to, created in host MinIO by
# scripts/k8s-local-secrets.sh. It deliberately gets NO public-read policy (the
# jtoye-images bucket does; database dumps must not be world-readable).
K8S_LOCAL_BACKUP_BUCKET=jtoye-db-backups

# Password for the BYPASSRLS `jtoye_backup` dump role that
# infra/backups/create-backup-role.sql creates. Required ONLY for the
# k8s-local path — scripts/k8s-local-secrets.sh validates it by name and
# refuses a CHANGE_ME value. WHY THE ROLE EXISTS: the tenant tables use FORCE
# ROW LEVEL SECURITY, so a pg_dump as the app role with no tenant GUC captures
# ZERO rows and the backup rehearsal would "pass" on an empty dump.
# NAMING: k8s/QUICK_START.md calls this same value POSTGRES_BACKUP_PASSWORD in
# its shell recipe. DB_BACKUP_PASSWORD is used here because it pairs with the
# DB_USER / DB_PASSWORD app-role keys and stays deliberately distinct from the
# POSTGRES_* superuser pair. Generate with: openssl rand -hex 32
DB_BACKUP_PASSWORD=CHANGE_ME

# HMAC signing key for RFC 8058 one-click unsubscribe links
# (notification.unsubscribe.signing-secret). EMPTY BY DEFAULT AND INERT: with no
# value the feature signs over an empty key, so scripts/k8s-local-secrets.sh
# skips the notification-credentials Secret entirely (its manifest ref is
# `optional: true`). Set a real value to exercise the unsubscribe path.
# Generate with: openssl rand -hex 32
NOTIFICATION_UNSUBSCRIBE_SECRET=
