# =============================================================================
# REFERENCE ONLY — NOT APPLIED BY KUSTOMIZE (issue #100 / P2-9).
#
# This file is deliberately named *.example so it is NOT a live kustomize
# resource. `kubectl kustomize` / `kubectl apply -k` of k8s/base and every
# overlay emits ZERO `kind: Secret` objects — CI enforces this via
# k8s/scripts/check-no-plaintext-secrets.sh.
#
# The Secret objects described below MUST exist in the target namespace
# OUT-OF-BAND, BEFORE `kubectl apply -k k8s/<env>/` — otherwise pods stay in
# CreateContainerConfigError and the pg-backup CronJob fails. Create them via:
#   * SealedSecrets (recommended): docs/runbooks/sealed-secrets.md — use this
#     file as the input shape for k8s/scripts/seal-secrets.sh, then commit the
#     resulting *.sealed.yaml manifests into the overlay resources.
#   * kubectl create secret generic ... (bootstrap only): k8s/QUICK_START.md
#     Step 1 has copy-paste commands covering every secret listed here.
#
# Required secrets (consumed by base deployments / cronjob):
#   postgres-credentials   — core-java-deployment.yaml, pg-backup-cronjob.yaml
#   s3-backup-credentials  — pg-backup-cronjob.yaml (#90)
#   keycloak-credentials   — frontend-deployment.yaml
#   nextauth-secret        — frontend-deployment.yaml
#   redis-credentials      — core-java-deployment.yaml
#   rabbitmq-credentials   — core-java-deployment.yaml
#
# OPTIONAL secrets (Phase 26 / DEF-6 / D-15 — all consumed by
# core-java-deployment.yaml). Every one of these is referenced with the
# secretKeyRef `optional` flag set, so an ABSENT Secret does NOT block pod
# start: the env simply stays unset, application.yml's own default applies, and
# that feature stays INERT — exactly today's behaviour. Creating the Secret is
# the deliberate act that activates the feature. Contrast this with the
# REQUIRED list above, whose refs carry no optional flag: a missing Secret (or
# a missing KEY inside an existing Secret) there puts pods into
# CreateContainerConfigError.
#   s3-media-credentials     — OPTIONAL. Vendor image uploads (Phase 24
#                              IMG-01..04). Absent -> storage.s3 credentials
#                              keep their application.yml defaults.
#   smtp-credentials         — OPTIONAL. Outbound email (Phase 22 COMMS-*).
#                              Absent -> empty user/pass; and app-config's
#                              smtp.auth stays "false", so no credential is
#                              offered to any relay either way.
#   stripe-credentials       — OPTIONAL. Payments + Stripe webhook signature
#                              verification. Absent -> empty defaults, payment
#                              behaviour unchanged.
#   notification-credentials — OPTIONAL but SECURITY-RELEVANT. Holds the
#                              unsubscribe-link HMAC signing key, whose
#                              application.yml default is the EMPTY STRING —
#                              i.e. an HMAC over an empty key, which is
#                              forgeable. Create it in any environment that
#                              actually sends notification email.
#
# Dev / local docker-compose is unaffected (uses .env, not k8s).
# =============================================================================
# TEMPLATE FILE - DO NOT COMMIT ACTUAL SECRETS TO GIT
# Use Sealed Secrets, External Secrets Operator, or Vault in production

---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
type: Opaque
stringData:
  host: "postgresql-primary.jtoye-infrastructure.svc.cluster.local"
  port: "5432"
  database: "jtoye"
  # DEF-2 (Phase 26 / INFRA-02b): this MUST be the NOSUPERUSER application role,
  # NOT the `jtoye` superuser this template used to name.
  #
  # A PostgreSQL superuser BYPASSES every Row-Level Security policy, which makes
  # multi-tenant isolation impossible — one tenant's request could read another
  # tenant's rows. core-java refuses to start rather than run that way:
  # DatabaseConfigurationValidator queries pg_roles at boot and throws
  # SecurityConfigurationException ("Application is using PostgreSQL superuser
  # ... Superusers BYPASS Row-Level Security policies"). So a copy-paste deploy
  # using the old value did not silently lose isolation — it made core-java
  # refuse to boot. Either way it is wrong.
  #
  # In .env the two are already separate pairs, and it is the FORMER you want:
  #   DB_USER / DB_PASSWORD             -> the app role (jtoye_app) — USE THIS
  #   POSTGRES_USER / POSTGRES_PASSWORD -> the superuser — do NOT use for the app
  username: "jtoye_app"
  password: "REPLACE_WITH_SECURE_PASSWORD"  # Generate strong password
  # SEC-04 / #552 (D-01) — the SECOND correction to this block. Phase 26 changed
  # `username` from the `jtoye` superuser to `jtoye_app` (DEF-2, above). This time
  # the distinction is owner-vs-runtime: `jtoye_app` (username) is the OWNER of
  # every table and the migrator Flyway runs as, and an owner is kept off tenant
  # rows ONLY by FORCE RLS being remembered on every future table. `jtoye_runtime`
  # below cannot own anything, so it can never be the role ownership exempts — it
  # is what the APPLICATION should connect as (DB_USER), leaving `username` above
  # as the migrator only (DB_MIGRATION_USER). Provision it with
  # infra/db/create-runtime-role.sql. The Deployment's env mapping is rewired to
  # read these keys by plan 28-08 (the live-application step); this template only
  # declares them.
  runtime-username: "jtoye_runtime"
  runtime-password: "REPLACE_WITH_SECURE_PASSWORD"  # Generate strong password
  # Least-privilege BYPASSRLS dump role for pg-backup (#90). Create it as the
  # superuser via infra/backups/create-backup-role.sql — pg_dump as the app role
  # would capture 0 rows from FORCE-RLS tenant tables.
  backup-username: "jtoye_backup"
  backup-password: "REPLACE_WITH_SECURE_PASSWORD"

---
apiVersion: v1
kind: Secret
metadata:
  # S3 credentials for the pg-backup CronJob (#90). Scope to a bucket-limited IAM
  # user / MinIO service account with PutObject/ListBucket/DeleteObject only.
  name: s3-backup-credentials
type: Opaque
stringData:
  # Placeholders replaced at deploy time (Sealed Secrets / external-secrets), not
  # real credentials — gitleaks:allow suppresses the generic-api-key false positive.
  access-key: "REPLACE_WITH_S3_ACCESS_KEY"  # gitleaks:allow
  secret-key: "REPLACE_WITH_S3_SECRET_KEY"  # gitleaks:allow

---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-credentials
type: Opaque
stringData:
  admin-username: "admin"
  admin-password: "REPLACE_WITH_SECURE_PASSWORD"
  frontend-client-secret: "REPLACE_WITH_KEYCLOAK_CLIENT_SECRET"
  core-api-client-secret: "REPLACE_WITH_KEYCLOAK_CLIENT_SECRET"

---
apiVersion: v1
kind: Secret
metadata:
  name: nextauth-secret
type: Opaque
stringData:
  # Generate with: openssl rand -base64 32
  secret: "REPLACE_WITH_32_CHARACTER_RANDOM_STRING"

---
apiVersion: v1
kind: Secret
metadata:
  name: redis-credentials
type: Opaque
stringData:
  password: "REPLACE_WITH_SECURE_PASSWORD"

---
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-credentials
type: Opaque
stringData:
  # NOTE: `jtoye` here is the RabbitMQ BROKER user, not a database role — the
  # DEF-2 superuser correction above does NOT apply to it. This is also the value
  # the PRE-ROLLOUT OPERATOR CHECK in k8s/base/core-java-deployment.yaml expects
  # to find in the live Secret after the RABBITMQ_USERNAME -> RABBITMQ_USER
  # rename. Leave it as `jtoye`.
  username: "jtoye"
  password: "REPLACE_WITH_SECURE_PASSWORD"
  stomp-login: "jtoye"
  stomp-passcode: "REPLACE_WITH_SECURE_PASSWORD"

# =============================================================================
# OPTIONAL secrets (Phase 26 / DEF-6 / D-15). Consumed by
# core-java-deployment.yaml with the secretKeyRef `optional` flag set, so an
# absent Secret leaves the feature inert instead of blocking pod start. Create
# only the ones whose feature you are activating in that environment.
# =============================================================================

---
apiVersion: v1
kind: Secret
metadata:
  # OPTIONAL. Vendor media uploads (Phase 24 IMG-01..04) — the S3/MinIO bucket
  # named by app-config s3.bucket / s3.endpoint. Scope to a bucket-limited IAM
  # user or MinIO service account (GetObject/PutObject/DeleteObject only). This
  # is a DIFFERENT, narrower grant than s3-backup-credentials above, which
  # targets the pg-backup bucket.
  name: s3-media-credentials
type: Opaque
stringData:
  # Placeholders replaced at deploy time (Sealed Secrets / external-secrets), not
  # real credentials — gitleaks:allow suppresses the generic-api-key false positive.
  access-key: "REPLACE_WITH_S3_MEDIA_ACCESS_KEY"  # gitleaks:allow
  secret-key: "REPLACE_WITH_S3_MEDIA_SECRET_KEY"  # gitleaks:allow

---
apiVersion: v1
kind: Secret
metadata:
  # OPTIONAL. Outbound email relay (Phase 22 COMMS-*). app-config smtp.host
  # points at the AWS SES SMTP endpoint for the deployment region, so these are
  # SES SMTP credentials (an IAM SMTP user), NOT an IAM access key pair.
  # Creating this Secret alone is not enough: app-config smtp.auth also has to be
  # flipped to "true" in that environment's configmap-patch.yaml, and the SES
  # sending domain must be verified in the region — otherwise the first send is a
  # loud SMTP auth failure rather than the previous silent no-op.
  name: smtp-credentials
type: Opaque
stringData:
  username: "REPLACE_WITH_SES_SMTP_USERNAME"  # gitleaks:allow
  password: "REPLACE_WITH_SES_SMTP_PASSWORD"  # gitleaks:allow

---
apiVersion: v1
kind: Secret
metadata:
  # OPTIONAL. Stripe payments. api-key is the SECRET key (sk_live_… /
  # sk_test_…), never a publishable key. webhook-secret (whsec_…) is what the
  # Stripe webhook handler verifies inbound event signatures against — an absent
  # or wrong value means events are rejected, so treat it as required as soon as
  # payments are live in that environment.
  name: stripe-credentials
type: Opaque
stringData:
  api-key: "REPLACE_WITH_STRIPE_SECRET_KEY"  # gitleaks:allow
  webhook-secret: "REPLACE_WITH_STRIPE_WEBHOOK_SECRET"  # gitleaks:allow

---
apiVersion: v1
kind: Secret
metadata:
  # OPTIONAL but SECURITY-RELEVANT. HMAC signing key for one-click unsubscribe
  # links in notification email. Its application.yml default is the EMPTY
  # STRING — an HMAC over an empty key, which is forgeable — so create this in
  # any environment that actually sends notification email.
  # Generate with: openssl rand -base64 32
  name: notification-credentials
type: Opaque
stringData:
  unsubscribe-signing-secret: "REPLACE_WITH_32_CHARACTER_RANDOM_STRING"  # gitleaks:allow

# How to create secrets in production:
#
# 1. Using kubectl (NOT recommended for production):
#    # DEF-2: username is the NOSUPERUSER owner/migrator role, never the `jtoye`
#    # superuser — a superuser bypasses RLS and core-java refuses to boot.
#    # SEC-04 (D-01): runtime-username is the DML-only role the app connects as
#    # (DB_USER); username=jtoye_app is now the migrator (DB_MIGRATION_USER).
#    kubectl create secret generic postgres-credentials \
#      --from-literal=username=jtoye_app \
#      --from-literal=password='your-secure-password' \
#      --from-literal=runtime-username=jtoye_runtime \
#      --from-literal=runtime-password='your-secure-runtime-password' \
#      -n jtoye-production
#
# 2. Using Sealed Secrets (recommended):
#    kubeseal --format=yaml < secrets.yaml > sealed-secrets.yaml
#    kubectl apply -f sealed-secrets.yaml
#
# 3. Using External Secrets Operator with AWS Secrets Manager:
#    apiVersion: external-secrets.io/v1beta1
#    kind: ExternalSecret
#    metadata:
#      name: postgres-credentials
#    spec:
#      secretStoreRef:
#        name: aws-secretsmanager
#        kind: SecretStore
#      target:
#        name: postgres-credentials
#      data:
#      - secretKey: password
#        remoteRef:
#          key: jtoye/postgres/password
