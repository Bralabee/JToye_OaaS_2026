# ===========================
# J'Toye OaaS - Edge Go API Environment Configuration
# ===========================
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
#    Windows: copy .env.example .env
#    Linux/Mac: cp .env.example .env
#
# 2. Update values as needed for your environment
# 3. NEVER commit .env to version control
#
# Note: These variables are used when running edge-go locally.
# Docker Compose uses its own configuration in docker-compose.full-stack.yml
#
# ===========================

# Core API Configuration
# URL of the core-java Spring Boot API
# Default for local development: http://localhost:9090
CORE_API_URL=http://localhost:9090

# Keycloak Configuration
# OAuth2 JWT validation
# Must match the issuer in JWT tokens from Keycloak
# Format: http://<host>:<port>/realms/<realm-name>
KC_ISSUER_URI=http://localhost:8085/realms/jtoye-dev

# JWKS refresh cadence (optional). Parsed with Go's time.ParseDuration.
# Examples: "30s", "5m", "1h". Default: 5m. Invalid values fall back to default.
# JWKS_REFRESH_INTERVAL=5m

# Server Configuration
# Port the Go service will run on
# Default: 8080 (Note: Docker maps this to 8089 on host)
PORT=8080

# Rate limiting (optional). Two layers since 37-25 (D-19 / RWO-039):
# 1. The pre-auth valve: a flood guard, NOT a quota, keyed PER CLIENT ADDRESS
#    (#808). RATE_LIMIT_IP_MAX bounds the addresses tracked; X-Forwarded-For is
#    believed only from TRUSTED_PROXY_CIDRS (empty = trust none).
# RATE_LIMIT_RPS=200
# RATE_LIMIT_BURST=400
# RATE_LIMIT_IP_MAX=10000
#    IPv6 clients are keyed on their /64. RATE_LIMIT_GLOBAL_RPS / _BURST are a
#    per-replica ceiling over ALL addresses together (default 5x the per-address
#    pair), so a flood spread over many sources is still bounded.
# RATE_LIMIT_GLOBAL_RPS=1000
# RATE_LIMIT_GLOBAL_BURST=2000
# TRUSTED_PROXY_CIDRS=
# 2. The per-tenant bucket, applied AFTER JWT validation on the protected
#    routes and keyed on the token's tenant_id, so one integrator's burst
#    cannot exhaust another vendor's sync. Every 429 from either layer is
#    application/problem+json (type https://jtoye.uk/errors/rate-limited)
#    with Retry-After and the X-RateLimit-Limit/Remaining/Reset headers.
# RATE_LIMIT_TENANT_RPS=10
# RATE_LIMIT_TENANT_BURST=20
#    Bound on the per-tenant buckets held in memory; tenants beyond it share
#    one overflow bucket.
# RATE_LIMIT_TENANT_MAX=10000

# Circuit Breaker Configuration (optional)
# CB_MAX_REQUESTS=3
# CB_INTERVAL=60s
# CB_TIMEOUT=30s

# Logging Configuration (optional)
# LOG_LEVEL=info
