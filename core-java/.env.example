# ===========================
# J'Toye OaaS - Core Java API Environment Configuration
# ===========================
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
#    Windows: copy .env.example .env
#    Linux/Mac: cp .env.example .env
#
# 2. Update values as needed for your environment
# 3. NEVER commit .env to version control
#
# Note: These variables are used by run-app.sh and when running locally.
# Docker Compose uses its own configuration in docker-compose.full-stack.yml
#
# ===========================

# Database Configuration
# PostgreSQL connection details
# Default for local development with Docker: localhost:5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jtoye
DB_USER=jtoye_runtime
DB_PASSWORD=CHANGE_ME
# Flyway migrates as the OWNER role and it must NOT be DB_USER: jtoye_runtime holds DML
# grants and no CREATE, while jtoye_app OWNS every public table and
# DatabaseConfigurationValidator.validateNotTableOwner() refuses to boot the application as
# a table owner. Keep the two separate. scripts/run-app.sh sources the repo-root .env FIRST
# and this file SECOND, so anything set here overrides the root value.
DB_MIGRATION_USER=jtoye_app
# DB_MIGRATION_PASSWORD is inherited from the repo-root .env unless you set it here.

# DSAR subject-address encryption key (31.1-07, decision D-19): exactly 64 hexadecimal
# characters, and core-java REFUSES TO START without a valid one. It encrypts the address a
# data-subject request was lodged with. It is inherited from the repo-root .env (the file
# docker-compose.full-stack.yml and scripts/verify-env.sh read), which is the one place to
# set it. Uncomment the line below only to give this host process a DIFFERENT key, and fill
# it with a fresh value from:
#   openssl rand -hex 32
# Leaving a placeholder here would override the root .env's real key, because
# scripts/run-app.sh sources this file second.
# DSAR_ENCRYPTION_KEY=

# Database Connection Pool Settings (optional)
# DB_POOL_SIZE=20
# DB_POOL_MIN_IDLE=5

# Server Configuration
# Port the Spring Boot application will run on
SERVER_PORT=9090

# Keycloak Configuration
# OAuth2 Resource Server JWT validation
# Must match the issuer in JWT tokens from Keycloak
# Format: http://<host>:<port>/realms/<realm-name>
KC_ISSUER_URI=http://localhost:8085/realms/jtoye-dev

# Spring Profile
# Options: dev, prod, local
# dev = enables dev tools, detailed logging
# prod = optimized for production
SPRING_PROFILES_ACTIVE=dev

# Redis Configuration (optional, for future caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=<rotated-2026-08-29-see-.env>

# RabbitMQ Configuration (optional, for future messaging)
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=jtoye
# RABBITMQ_PASSWORD=<rotated-2026-08-29-see-.env>

# Logging Configuration
# LOG_LEVEL=INFO
# SQL_LOG_LEVEL=WARN
# SECURITY_LOG_LEVEL=INFO

# JVM Options (optional)
# JAVA_OPTS=-Xmx2g -Xms512m
