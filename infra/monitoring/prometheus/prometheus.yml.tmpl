# Prometheus configuration TEMPLATE for JToye OaaS monitoring (phase 27, plan 27-00).
#
# Placeholders (__CORE_JAVA_METRICS_PORT__, __EDGE_GO_METRICS_PORT__) are rendered at
# container start by entrypoint.sh using sed. The rendered output (prometheus.yml) is
# .gitignored. A template edit therefore needs the container RECREATED, not restarted
# into an existing render — `up -d --force-recreate prometheus`.
#
# Prometheus has no native env-var substitution in scrape configs, which is why the
# sed wrapper exists — the same reason and the same mechanism as
# ../alertmanager/alertmanager.yml.tmpl. DO NOT replace with ${VAR} syntax:
# Prometheus passes it through literally and the target becomes unresolvable.
#
# EDITING THIS FILE: edit the .tmpl, never the rendered prometheus.yml (it is
# overwritten on every container start). `/-/reload` is not enabled, so after editing
# run `docker compose -f infra/monitoring/docker-compose.monitoring.yml up -d
# --force-recreate prometheus` — a plain `restart` re-runs the entrypoint too, but
# only `up -d` picks up a changed environment value.
global:
  scrape_interval: 15s # Scrape targets every 15 seconds
  evaluation_interval: 15s # Evaluate rules every 15 seconds
  external_labels:
    cluster: 'jtoye-dev'
    environment: 'development'

# Alertmanager — phase 9. Lives in infra/monitoring/docker-compose.monitoring.yml
# on the same `monitoring` network as this Prometheus, so DNS resolution by
# service name works without any extra config. `/-/reload` endpoint is not
# enabled on Prometheus — after editing this file you must
# `docker compose restart prometheus`.
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

# Load alerting rules
rule_files:
  - 'alerts.yml'

# Scrape configurations
scrape_configs:
  # Prometheus itself
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          service: 'prometheus'

  # Core Java API (Spring Boot Actuator).
  #
  # The actuator port DIFFERS BY RUNTIME, which is why this is injected and not a
  # literal (phase 27, plan 27-00):
  #
  #   prod / k8s  — application-prod.yml:106-107 sets a SEPARATE internal
  #                 management port, `${MANAGEMENT_SERVER_PORT:9091}`, so actuator
  #                 is served ONLY there. k8s/base/core-java-deployment.yaml
  #                 declares containerPort 9091 `management` and annotates
  #                 `prometheus.io/port: "9091"` — correct for that runtime.
  #   dev/compose — docker-compose.full-stack.yml:173 runs SPRING_PROFILES_ACTIVE=dev,
  #                 which sets NO management.server.port, so the actuator stays on the
  #                 app port `${SERVER_PORT:9090}` (application.yml:252) and the scrape
  #                 endpoint is opted in via MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE
  #                 (docker-compose.full-stack.yml:209).
  #
  # Before 27-00 this line was the literal `core-java:9091`, which is the prod value.
  # Against the dev profile nothing binds 9091, so the target was DOWN and SIX alerts
  # were dataless while TWO more (HighMemoryUsage, FrequentGarbageCollection) silently
  # bound to Keycloak's JVM despite carrying `service: core-java`. Evidence:
  # .planning/phases/27-operational-maturity/baselines/B-1.txt, B-7.txt.
  #
  # Substituting one literal for another would only move which runtime is wrong, and
  # would re-arm the moment SERVER_PORT or MANAGEMENT_SERVER_PORT is overridden. The
  # value therefore comes from CORE_JAVA_METRICS_PORT via entrypoint.sh, the same
  # render-at-start idiom alertmanager already uses in the sibling directory.
  - job_name: 'core-java'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets: ['core-java:__CORE_JAVA_METRICS_PORT__']
        labels:
          service: 'core-api'
          component: 'backend'
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: 'core-java'

  # Edge Go API (Gin gateway) — the edge exposes a Prometheus /metrics endpoint
  # (prometheusMiddleware + promhttp in edge-go/cmd/edge/metrics.go), emitting
  # http_requests_total + http_request_duration_seconds labelled by
  # method/route-template/status. Job re-enabled (issue #98 item 3).
  #
  # THE PORT IS INJECTED, for the same reason as core-java above and one more.
  #
  #   dev/compose — the MANAGEMENT port (EDGE_GO_METRICS_PORT, default 9101).
  #                 docker-compose.full-stack.yml sets EDGE_MANAGEMENT_PORT on the
  #                 edge-go service from that same .env key, which is what moves
  #                 the route off the published app port (issue #550, SEC-02/C4).
  #   k8s         — unset, so /metrics stays on the app port 8080, which is what
  #                 k8s/base/edge-go-deployment.yaml's prometheus.io/port
  #                 annotation already says. No Prometheus is deployed there yet
  #                 (DPLY-03), so nothing in-cluster reads this file.
  #
  # The edge serves /metrics on EXACTLY ONE of the two ports — registerAppMetricsRoute
  # in edge-go/cmd/edge/main.go registers the app-port route only while
  # EDGE_MANAGEMENT_PORT is empty. So a value here that disagrees with the edge's
  # own EDGE_MANAGEMENT_PORT is a permanently-DOWN target, never a duplicate scrape;
  # both come from the one .env key precisely so that cannot happen.
  - job_name: 'edge-go'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['jtoye-edge-go:__EDGE_GO_METRICS_PORT__']
        labels:
          service: 'edge-api'
          component: 'gateway'
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: 'edge-go'

  # PostgreSQL Database
  - job_name: 'postgres'
    static_configs:
      - targets: ['jtoye-postgres-exporter:9187']
        labels:
          service: 'postgresql'
          component: 'database'

  # Keycloak (if metrics endpoint available)
  - job_name: 'keycloak'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['jtoye-keycloak:8080']
        labels:
          service: 'keycloak'
          component: 'auth'
    # Keycloak may not expose metrics by default - this is optional

  # Redis (if exporter added)
  - job_name: 'redis'
    static_configs:
      - targets: ['redis-exporter:9121']
        labels:
          service: 'redis'
          component: 'cache'
    # Only if redis-exporter is added to docker-compose

  # RabbitMQ Management Plugin
  - job_name: 'rabbitmq'
    static_configs:
      - targets: ['jtoye-rabbitmq:15692']
        labels:
          service: 'rabbitmq'
          component: 'messaging'
    # RabbitMQ management plugin exposes Prometheus metrics on port 15692
    #
    # LEAVE THIS JOB ALONE. It supplies the node-level series and the `up` series
    # RabbitMQDown depends on. The per-queue job below is ADDITIVE — see its header.

  # RabbitMQ PER-QUEUE metrics (phase 27, plan 27-03, decision D-01).
  #
  # WHY A SECOND JOB EXISTS. The default /metrics endpoint above returns metrics
  # AGGREGATED BY NAME — it carries no `queue` and no `vhost` label at all. Measured
  # live 2026-07-29:
  #
  #   query=rabbitmq_queue_messages_ready
  #     -> {__name__, component, instance, job, service} = 9      <- NO queue label
  #
  # That is why the repo's only messaging rule, StompBrokerLag, could never fire: its
  # `queue=~"stomp-subscription.*|amq[.]gen-.*"` selector matched a series family that
  # has no `queue` label, so it returned the empty vector from the day it was written
  # while nine real dead messages sat unreported on webhook.deliveries.dlq. `promtool
  # check rules` passed the file throughout — syntax validity is exactly the assurance
  # that is worthless here.
  #
  # DISTINCT PREFIX, SO IT CANNOT COLLIDE. /metrics/detailed emits the
  # `rabbitmq_detailed_` prefix, which the plugin designs for concurrent use with the
  # aggregated endpoint. No existing expression changes meaning.
  #
  # THE TWO FAMILIES AND WHAT THEY YIELD (measured, not assumed):
  #   queue_coarse_metrics  -> rabbitmq_detailed_queue_messages
  #                            rabbitmq_detailed_queue_messages_ready
  #                            rabbitmq_detailed_queue_messages_unacked
  #                            rabbitmq_detailed_queue_process_reductions_total
  #   queue_consumer_count  -> rabbitmq_detailed_queue_consumers
  #
  # COST, MEASURED RATHER THAN ASSERTED (2026-07-29, 13 queues):
  #   /metrics/detailed?family=queue_coarse_metrics&family=queue_consumer_count   92 lines
  #   /metrics/per-object                                                       3439 lines
  #   /metrics (aggregated, the job above)                                      3135 lines
  # per-object was rejected: it grows with connections and channels, and it REPLACES
  # the aggregated series rather than adding to them.
  #
  # ACCEPTED COST: this adds a second `up{job="rabbitmq-queues"}` series, so one broker
  # outage can be named by ServiceDown under either job. That is the same outage, not a
  # new fault — the runbook says so, and RabbitMQDown is deliberately scoped to
  # job="rabbitmq" only so the two can never double-page.
  #
  # /-/reload is NOT enabled (see the file header), so applying a change here needs
  #   docker compose -f infra/monitoring/docker-compose.monitoring.yml up -d \
  #     --force-recreate prometheus
  - job_name: 'rabbitmq-queues'
    metrics_path: '/metrics/detailed'
    params:
      family: ['queue_coarse_metrics', 'queue_consumer_count']
    static_configs:
      - targets: ['jtoye-rabbitmq:15692']
        labels:
          service: 'rabbitmq'
          component: 'messaging'
    metric_relabel_configs:
      # LOAD-BEARING, NOT DECORATIVE. The SSE fan-out declares an AnonymousQueue per
      # JVM (RabbitMQConfig.ORDER_EVENTS_FANOUT_QUEUE_PREFIX ->
      # order.state-changes.sse.<random>); the random suffix changes on EVERY restart,
      # so keeping these series would leak one label value per restart, forever.
      # Durable queues only. Proven load-bearing by its own control: comment this block
      # out and `rabbitmq_detailed_queue_messages_ready{queue=~"order[.]state-changes[.]sse[.].*"}`
      # goes from empty to >= 1 naming the live SSE queue (27-03 T1.4).
      - source_labels: [queue]
        regex: 'order[.]state-changes[.]sse[.].*'
        action: drop
