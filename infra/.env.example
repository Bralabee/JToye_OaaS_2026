# ===========================
# J'Toye OaaS - Infrastructure Environment Configuration
# ===========================
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the same directory
#    Windows: copy .env.example .env
#    Linux/Mac: cp .env.example .env
#
# 2. Values below are suitable for local development
# 3. For production, change all passwords and secrets!
# 4. NEVER commit .env to version control
#
# This file is used by infra/docker-compose.yml for local infrastructure
#
# ===========================

# ===========================
# DATABASE CONFIGURATION
# ===========================
# PostgreSQL configuration for Docker Compose
# These values are used inside the Docker network
DB_HOST=postgres
DB_PORT=5432
DB_NAME=jtoye
DB_USER=jtoye
# Generate a strong value (openssl rand -hex 32); compose fails loud if unset.
DB_PASSWORD=CHANGE_ME

# ===========================
# KEYCLOAK CONFIGURATION
# ===========================
# Keycloak admin console credentials
# Access at: http://localhost:8085
KC_ADMIN=admin
# Generate a strong value (openssl rand -hex 32); compose fails loud if unset.
KC_ADMIN_PASSWORD=CHANGE_ME

# Keycloak realm name
KC_REALM=jtoye-dev

# ===========================
# KEYCLOAK REALM RENDER (issue #80)
# ===========================
# The keycloak-realm-render sidecar renders infra/keycloak/realm-export.json from
# realm-export.template.json using these values. NEVER commit the rendered file.
# Generate each with: openssl rand -hex 32
# KEYCLOAK_CLIENT_SECRET also feeds the frontend NextAuth provider (same value).
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
EDGE_API_CLIENT_SECRET=CHANGE_ME
# Renders the seed-user (tenant-a-user/tenant-b-user/admin-user) login password.
KC_SEED_USER_PASSWORD=CHANGE_ME
# Renders the integration-catalog-ro machine client secret (issue #206 [AI-4]):
# the read-only catalog client-credentials sample.
INTEGRATION_CATALOG_RO_SECRET=CHANGE_ME

# ===========================
# NOTES
# ===========================
# - No credentials are committed. The realm import is templated (realm-export.template.json)
#   and rendered at container start; the rendered realm-export.json is gitignored.
# - Seed users (admin-user / tenant-a-user / tenant-b-user) all use ${KC_SEED_USER_PASSWORD}.
# - Never use weak default values; rotate every secret on suspected compromise.
